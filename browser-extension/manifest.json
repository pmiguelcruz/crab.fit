{
  "name": "Crab Fit",
  "description": "Save, share, and open your Crab Fit polls from the browser toolbar.",
  "version": "1.4",
  "manifest_version": 3,

  "author": "Ben Grant",
  "homepage_url": "https://crab.fit",

  "permissions": ["activeTab", "storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Crab Fit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "res/icon16.png",
      "32": "res/icon32.png",
      "48": "res/icon48.png",
      "128": "res/icon128.png"
    }
  },
  "icons": {
    "16": "res/icon16.png",
    "32": "res/icon32.png",
    "48": "res/icon48.png",
    "128": "res/icon128.png"
  }
}
